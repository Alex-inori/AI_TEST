{
  "manifest_version": 3,
  "name": "HAPS Local Bridge",
  "version": "1.0.0",
  "description": "Bridge web UI to local terminal/cfgprosh/filesystem via native messaging.",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["http://127.0.0.1:*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:*/*"],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ]
}
